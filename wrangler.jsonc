{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "safenet-proxy-v2",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-17",
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	// Secrets (set via `wrangler secret put`):
	//   PRIVATE_KEY    — hex-encoded private key used to sign transactions on all chains
	//   RPC_URLS       — JSON string mapping chain ID to RPC URL, e.g. {"11155111":"https://...","100":"https://..."}
	//   SAFE_API_KEY   — API Key for the Safe API
	"vars": {
		// Mapping of chain ID to a list of consensus configs (address + optional oracle, + optional
		// disableSampled to skip transactions received via the sampled endpoint)
		"CONSENSUS_CONFIGS": {
			"100": [
				{
					"address": "0x73b4BDc3112Dfb86085cDD84f26Ab908B20A4A84",
					"oracle": "0xB83c4b66e752D947c1F55fd703b7937e21e401E4"
				},
				{
					"address": "0xc855761D619f6002923507cE68B84d7689C2aa96",
					"oracle": "0x4F61B8832978e83b80D69551AEf07557DBE41d03",
					"disableSampled": true
				}
			]
		},
		// Mapping of chain ID to a relaying Safe config ({safe, multiSend} addresses)
		"RELAYING_SAFES": {
			"100": {
				"safe": "0xfDCb4233a28820bD0cB8A40f7C1DC1EC7A974eBA",
  				"multiSend": "0x9641d764fc13c8B624c04430C7356C1C7C8102e2"
			}
		},
		// Comma-separated list of chain IDs to submit attestations to
		"CHAIN_IDS": "100",
		"SAMPLE_RATE": "100",
		// Safe webhook type to react to
		// (EXECUTED_MULTISIG_TRANSACTION or PENDING_MULTISIG_TRANSACTION; defaults to EXECUTED_MULTISIG_TRANSACTION if unset)
		"WEBHOOK_TYPE": "PENDING_MULTISIG_TRANSACTION"
		// MAX_BATCH_GAS — maximum gas for a single batched execTransaction submitted through a
		// relaying Safe (defaults to 5000000 if unset), to stay clear of the chain's block gas limit
	},
	"queues": {
		"producers": [
			{
				"queue": "safenet-proposals-v2",
				"binding": "PROPOSAL_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "safenet-proposals-v2",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		]
	},
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	// "d1_databases": [
	//   {
	//     "binding": "MY_DB",
	//     "database_name": "my-database",
	//     "database_id": ""
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	}
}
