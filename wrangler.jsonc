{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "safenet-proxy-v2",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-17",
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	// Secrets (set via `wrangler secret put`):
	//   PRIVATE_KEY    — hex-encoded private key used to sign transactions on all chains
	//   RPC_URLS       — JSON string mapping chain ID to RPC URL, e.g. {"11155111":"https://...","100":"https://..."}
	//   SAFE_API_KEY   — API Key for the Safe API
	//   RELAYING_SAFES — JSON string mapping chain ID to a relaying Safe config ({safe, multiSend} addresses),
	//                    e.g. {"11155111":{"safe":"0x...","multiSend":"0x..."},"100":{"safe":"0x...","multiSend":"0x..."}}
	"vars": {
		// Mapping of chain ID to a list of consensus configs (address + optional oracle)
		"CONSENSUS_CONFIGS": {
			"100": [
				{
					"address": "0x98810887769db19A0Df9bf2f44E4998856fcb390",
					"oracle": "0x544F12bAd6FF72564abBc7eA6494A2a4BdD0DDD0"
				}
			]
		},
		// Comma-separated list of chain IDs to submit attestations to
		"CHAIN_IDS": "100",
		"SAMPLE_RATE": "5"
		// MAX_BATCH_GAS — maximum gas for a single batched execTransaction submitted through a
		// relaying Safe (defaults to 5000000 if unset), to stay clear of the chain's block gas limit
	},
	"queues": {
		"producers": [
			{
				"queue": "safenet-proposals-v2",
				"binding": "PROPOSAL_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "safenet-proposals-v2",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		]
	},
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	// "d1_databases": [
	//   {
	//     "binding": "MY_DB",
	//     "database_name": "my-database",
	//     "database_id": ""
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	}
}
