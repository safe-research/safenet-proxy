{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "safenet-proxy-v2",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-17",
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	// Secrets (set via `wrangler secret put`):
	//   PRIVATE_KEY  — hex-encoded private key used to sign transactions on all chains
	//   RPC_URLS     — JSON string mapping chain ID to RPC URL, e.g. {"11155111":"https://...","100":"https://..."}
	//   SAFE_API_KEY — API Key for the Safe API
	"vars": {
		// Mapping of chain ID to a list of consensus configs (address + optional oracle)
		"CONSENSUS_CONFIGS": {
			"11155111": [
				{
					"address": "0x2b4c601285221c6b0942b86Eb659Efc8a4dd8120",
					"oracle": "0x25275006cE9C4a4D5453e173D09134a24Bb44926"
				}
			]
		},
		// Comma-separated list of chain IDs to submit attestations to
		"CHAIN_IDS": "11155111",
		"SAMPLE_RATE": "100"
	},
	"queues": {
		"producers": [
			{
				"queue": "safenet-proposals-v2",
				"binding": "PROPOSAL_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "safenet-proposals-v2",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		]
	},
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	// "d1_databases": [
	//   {
	//     "binding": "MY_DB",
	//     "database_name": "my-database",
	//     "database_id": ""
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	}
}
